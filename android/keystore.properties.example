# Template for the release signing configuration read by android/app/build.gradle.kts.
#
# Copy this to  %USERPROFILE%\.hostelpro-keys\keystore.properties  (Windows) or
# ~/.hostelpro-keys/keystore.properties, fill in the real values, and never copy
# the filled-in file back into the repository. android/.gitignore and the root
# .gitignore both block `keystore.properties`, but the safest copy is the one
# that never exists here.
#
# CI should set environment variables instead - they take precedence over this file:
#   HOSTELPRO_KEYSTORE_FILE, HOSTELPRO_KEYSTORE_PASSWORD,
#   HOSTELPRO_KEY_ALIAS, HOSTELPRO_KEY_PASSWORD, HOSTELPRO_KEYSTORE_TYPE
#
# Set HOSTELPRO_KEYSTORE_PROPERTIES to read this file from somewhere else.
#
# Use forward slashes in storeFile even on Windows: this is a Java .properties
# file, where a backslash is an escape character and silently mangles the path.

storeFile=C:/Users/<you>/.hostelpro-keys/hostelpro-upload.p12
storeType=PKCS12
keyAlias=hostelpro-upload
storePassword=<the store password given to keytool -genkeypair>
keyPassword=<the key password given to keytool -genkeypair>
