<?xml version="1.0" encoding="utf-8"?>
<!--
  Trusted Web Activity wrapper for the NIVORA PWA.

  A TWA is a full-screen Custom Tab: the OS launches Chrome, Chrome checks the
  Digital Asset Links statement served at
  https://hostelpro-three.vercel.app/.well-known/assetlinks.json against the
  certificate this APK was signed with, and only if they match does it drop the
  URL bar. If verification fails the app still works but renders as a plain
  Custom Tab with a visible address bar — that is the symptom to look for.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The only permission the wrapper needs. Everything else happens in Chrome. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Android 11+ package visibility: without this the launcher cannot see which
      browsers are installed and cannot decide whether a TWA-capable one exists.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NIVORA">

        <!--
          Kept for the https:// deep-link filter below (autoVerify still reads assetlinks.json).
          Nothing about LAUNCHING the app depends on it any more — that was the TWA handshake,
          and its failure is what used to produce a Chrome address bar.
        -->
        <meta-data
            android:name="asset_statements"
            android:resource="@string/asset_statements" />

        <!--
          The application shell. A WebView we own, NOT a browser handoff.
          The previous TWA LauncherActivity handed the URL to Chrome, which is why the app
          "opened Chrome": Chrome was the renderer, and a Custom Tab (with an address bar) was
          the fallback whenever Digital Asset Links verification did not hold. A WebView has no
          address bar to show and no handshake to fail.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.NIVORA.Launcher">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Deep links still land in the app. autoVerify keeps working off assetlinks.json,
              but nothing depends on it any more: if verification fails the icon still opens
              this Activity, it just does not also claim https:// links from other apps.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="${hostName}" />
            </intent-filter>
        </activity>


        <!--
          Lets Chrome hand the splash bitmap over, and is the binding point for
          any future notification delegation.
        -->

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
