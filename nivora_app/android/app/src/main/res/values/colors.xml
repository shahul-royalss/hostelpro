<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      THE LAUNCH GROUND, #EBE3D8 — the warm beige the Apnivaas launch animation is drawn on.

      Every surface between the launcher tap and the end of the animation paints this one value:
      the pre-Android-12 launch window (drawable/launch_background.xml, LaunchTheme), the Android
      12+ system splash (values-v31/ AND values-night-v31/styles.xml), the window behind Flutter
      (NormalTheme), the iOS launch screen (ios/Runner/Base.lproj/LaunchScreen.storyboard) and
      the Flutter splash itself (kSplashGround in lib/core/boot/splash_gate.dart).

      IT IS MEASURED, NOT PICKED. The animation's outer ring is blended into one flat colour when
      scripts/gen-icons.mjs builds assets/brand/apnivaas_splash.webp, and lossy WebP moves a flat
      colour by about one level when it encodes it (#EAE3D8 went in, #EBE3D8 comes out). This is
      the DECODED border of the shipped file, read back by the script, which refuses to finish if
      this line disagrees with it — a one-level square seam around the logo is visible on a phone
      in a dark room. test/splash_asset_bytes_test.dart holds the Dart, Android and iOS copies to
      this value.
    -->
    <color name="splash_ground">#EBE3D8</color>

    <!--
      The Figma design's dark page ground (#0B0D0F), NivoraColors.ground in
      lib/core/theme/tokens.dart. Nothing in res/ paints it any more — the app is light-only and
      the launch is the beige above — but the key is kept so a dark launch can be restored
      without archaeology.
    -->
    <color name="nivora_ground">#0B0D0F</color>
    <!--
      The Flutter light theme's ground, NivoraColors.background (#EEF0F8): the cool violet canvas
      every screen after the launch animation paints. The splash fades the beige into this before
      it hands over (lib/features/splash/splash_screen.dart), so the brand's warm ground and the
      app's cool one never meet as a hard cut. Not referenced by a theme any more; kept as the
      Android-side record of the value the fade lands on.
    -->
    <color name="nivora_ground_light">#EEF0F8</color>

    <!-- theme_color from app/manifest.ts -->
    <color name="colorPrimary">#F6F4EF</color>
    <color name="navigationColor">#F6F4EF</color>
    <!-- background_color from app/manifest.ts -->
    <color name="backgroundColor">#F6F4EF</color>
    <!--
      The plate behind the adaptive launcher icon, referenced only by
      mipmap-anydpi-v26/ic_launcher.xml and ic_launcher_round.xml.

      #FEFCF9 is the tile the Apnivaas artwork was drawn on (measured off Apnivaas_8K_UHD.png),
      and the same plate scripts/gen-icons.mjs puts under the legacy launcher icons, the iOS icon,
      the maskable web icon and the Play icon — so the icon looks the same on every launcher and
      in the store. A warm white rather than the splash beige: on a grid of white and pale icons
      the beige read as dirty.

      Regenerate the icon layers with: node scripts/gen-icons.mjs
    -->
    <color name="ic_launcher_background">#FEFCF9</color>

    <!--
      The accent Android tints the notification's small icon and app name with
      (AndroidManifest.xml, com.google.firebase.messaging.default_notification_color). The
      median green of the A-house mark, measured off nivora_app/assets/brand/apnivaas_mark.png
      with the window squares left out: 7.8:1 against a white shade, and the system adjusts it
      for contrast on a dark one.
    -->
    <color name="notification_accent">#235B4D</color>
</resources>
