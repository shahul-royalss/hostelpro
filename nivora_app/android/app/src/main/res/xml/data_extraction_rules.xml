<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) splits what android:allowBackup used to cover into two questions, and
  answers them separately: <cloud-backup> is Google Drive, <device-transfer> is the
  phone-to-phone copy during setup. allowBackup="false" alone does not stop the second one.

  Both are refused here for the same reason: the persisted Supabase session lives in
  shared_prefs, and a refresh token for a rent-management account should not survive leaving the
  device it was issued to. See the comment above <application> in AndroidManifest.xml.

  These are deliberately blanket excludes rather than a list of paths. A path list is a promise
  to remember to update it, and the next thing written to disk would be backed up by default.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
