<?xml version="1.0" encoding="utf-8"?>
<!--
  ANDROID 12+ (API 31): THE SYSTEM SPLASH IS PLAIN BEIGE, WITH NO ICON.

  From Android 12 the system draws its own splash before Flutter's first frame, and by default it
  is the LAUNCHER ICON on the window background. Left like that, a cold start reads: static A
  icon, blank, then the A building itself in the launch animation — the logo appearing twice
  with a gap between. So the system splash is told to show nothing but the launch ground
  (@color/splash_ground, the WebP's decoded border colour), which hands straight on to the
  animation's own empty opening frames.

  THIS FILE EXISTS TWICE, in values-v31/ and values-night-v31/, and must stay identical: Android
  ranks the night qualifier ABOVE the API-level one, so on a dark-mode phone values-night/styles.xml
  would otherwise beat values-v31/ and bring the icon back.
-->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_ground</item>
        <!-- An empty drawable, not the launcher icon: see the header. -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_none</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_ground</item>
    </style>
</resources>
