# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# android (TWA wrapper) build output
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
/android/captures/

# Android signing material - the release keystore and its passwords must never
# be committed. Losing it is unrecoverable, leaking it lets anyone ship an
# update signed as HostelPro. It lives in ~/.hostelpro-keys/ (docs/play-store.md).
keystore.properties
*.jks
*.p12
*.keystore

# generated by scripts/sbom.mjs; CI uploads it as a build artifact
sbom.json

# nested git repo committed as a gitlink with no .gitmodules entry; it made
# `actions/checkout` fail with "No url found for submodule path" on every CI run
skills/mvanhorn/

# Release artifacts (AAB/APK) — binaries, rebuilt from android/ on demand
/dist/

# Owner-supplied prototype kept as reference for components/payments/receipt-printer.tsx.
# Not built and not shipped; excluded from lint. Remove once the port is settled.
reciept animation/

# Vendored Claude Code skill content — tooling, not part of the product.
skills/
# Stray perf probes from tooling runs.
build/
